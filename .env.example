# API server
# Keep this value server-side. Never expose it as VITE_* or EXPO_PUBLIC_*.
GROQ_API_KEY=replace-with-your-groq-api-key

# Web app
# International WhatsApp number, digits only. Leave blank for local development.
VITE_WHATSAPP_NUMBER=

# Mobile app
# Public URL where the API server is reachable by the device.
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_WHATSAPP_NUMBER=